datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Submission {
  id        String   @id @default(cuid())
  name      String
  message   String?
  link      String
  status    String   @default("PENDING") // PENDING | QUEUED | PLAYING | DONE | REJECTED
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
