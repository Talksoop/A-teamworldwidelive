datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Host {
  id              String   @id @default(cuid())
  email           String   @unique
  passwordHash    String? // null for accounts created via Google sign-in that never set a password
  googleId        String?  @unique // Google's stable "sub" claim, once they've signed in with Google
  name            String // brand/display name shown on their public pages
  slug            String   @unique // used in URLs: /h/[slug]/...
  platformFeeBps  Int      @default(2000) // platform cut in basis points (2000 = 20%)
  stripeAccountId String? // Stripe Connect account id once they start onboarding
  stripeOnboarded Boolean  @default(false) // true once Connect reports charges_enabled
  isFounder       Boolean  @default(false) // the original single-tenant owner: charges go directly to the platform account, no Connect/fee needed
  createdAt       DateTime @default(now())
}

model Fan {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String? // null for accounts created via Google sign-in that never set a password
  googleId     String?  @unique // Google's stable "sub" claim, once they've signed in with Google
  name         String
  createdAt    DateTime @default(now())
}

model Follow {
  id        String   @id @default(cuid())
  fanId     String
  hostId    String
  createdAt DateTime @default(now())

  @@unique([fanId, hostId])
}

model Submission {
  id                 String   @id @default(cuid())
  hostId             String
  fanId              String?
  name               String
  email              String?
  songName           String?
  message            String?
  link               String // pasted URL, or the S3 object key when sourceType is UPLOAD
  sourceType         String   @default("LINK") // LINK | UPLOAD
  status             String   @default("PENDING") // PENDING_PAYMENT | PENDING | QUEUED | PLAYING | DONE | REJECTED
  order              Int      @default(0)
  paid               Boolean  @default(false)
  amountCents        Int      @default(0)
  skipOfferId        String?
  reactOfferId       String?
  parentSubmissionId String? // set on a free bonus song attached to a paid tier that allows extra songs
  stripeSessionId    String?  @unique
  createdAt          DateTime @default(now())
}

model Offer {
  id               String   @id @default(cuid())
  hostId           String
  type             String // SKIP | REACT
  name             String
  description      String?
  priceCents       Int
  priority         Int      @default(0) // SKIP only: higher = jumps further toward the front
  bonusSubmissions Int      @default(0) // SKIP only: extra free songs granted after this one is paid
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
}

model Battle {
  id         String   @id @default(cuid())
  hostId     String
  songAId    String
  songBId    String
  status     String   @default("SCHEDULED") // SCHEDULED | LIVE | DONE
  votesA     Int      @default(0)
  votesB     Int      @default(0)
  winnerSide String? // "A" | "B" — set when the battle ends
  createdAt  DateTime @default(now())
}

model Settings {
  id             String  @id @default(cuid())
  hostId         String  @unique
  submissionMode String  @default("FREE") // FREE | PAID
  basePriceCents Int     @default(0)
  amaEnabled     Boolean @default(false)
  amaPriceCents  Int     @default(1000)
  queueOpen      Boolean @default(true) // false = closed to new submissions; existing queue is untouched
}

model LiveEvent {
  id        String    @id @default(cuid())
  hostId    String
  title     String    @default("Going live")
  platform  String? // e.g. "Twitch", "TikTok", "YouTube", "Instagram Live"
  startsAt  DateTime
  endsAt    DateTime? // optional; same day as startsAt in the UI
  url       String? // optional link to the stream
  createdAt DateTime  @default(now())
}

model RadioRecommendation {
  id           String   @id @default(cuid())
  hostId       String
  submissionId String   @unique // one recommendation per submission
  fanId        String?
  name         String
  email        String?
  songName     String?
  link         String?
  emailSent    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model AmaRequest {
  id                 String    @id @default(cuid())
  hostId             String
  fanId              String?
  name               String
  email              String?
  question           String
  link               String?
  accessToken        String    @unique
  status             String    @default("PENDING_PAYMENT") // PENDING_PAYMENT | PENDING | ANSWERED
  paid               Boolean   @default(false)
  amountCents        Int       @default(0)
  stripeSessionId    String?   @unique
  responseText       String?
  responseLink       String? // pasted URL, or an S3 key when responseSourceType is UPLOAD
  responseSourceType String? // LINK | UPLOAD
  answeredAt         DateTime?
  createdAt          DateTime  @default(now())
}
